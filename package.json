{
  "name": "pi-secret",
  "version": "0.4.1",
  "description": "Keep API keys, tokens and passwords out of the model's context: the agent uses {{sec:NAME}} refs, the value is expanded only for the command that needs it.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "secrets",
    "credentials",
    "api-keys",
    "tokens",
    "redaction",
    "masked-input",
    "env",
    "security"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:canary": "vitest run test/integration && node scripts/canary-sweep.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "~0.85.1",
    "@earendil-works/pi-coding-agent": "~0.85.1",
    "@earendil-works/pi-tui": "~0.85.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.20.2",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kslamph/pi-secret.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
