# Golden vector for the file-import classifier (spec §12g).
#
# Shape: a realistic shell profile — the case that produced six false "likely secret"
# rows out of eight on a real ~/.bashrc (PS1, LD_LIBRARY_PATH, __conda_setup,
# NODE_EXTRA_CA_CERTS, BETTERWRIGHT_CHROMIUM_ARGS, debian_chroot).
#
# EVERY VALUE BELOW IS FABRICATED. Nothing here is a live credential, and nothing here
# should ever be replaced with one: this file is committed, and the whole point of the
# vector is that its verdicts are stable.
#
# `test/entropy.test.ts` reads THIS file and asserts the verdict per variable name, so
# the fixture and the contract cannot drift apart.

# --- shell noise: structure that must NOT be classified as a secret -----------
HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi
case "$TERM" in xterm-color|*-256color) color_prompt=yes;; esac
# A prompt is the worst case: braces, backslashes, digits, symbols, high entropy.
PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
CUDA_HOME=/usr/local/cuda
PATH="$CUDA_HOME/bin:$PATH"
# Colon-separated path list — entropy 4.5, and not a credential.
LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu
GOPROXY=https://proxy.golang.org,direct
NVM_DIR="$HOME/.nvm"
# Tilde path, so the filesystem-path exclusion has to handle `~` and not just `/`.
NODE_EXTRA_CA_CERTS=~/.local/share/mkcert/rootCA.pem
__conda_setup="$('/opt/conda/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
QLTY_INSTALL=/home/dev/.qlty/bin
KUBECONFIG=/home/dev/.kube/config
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
ANDROID_HOME=/home/dev/Android/Sdk
GRADLE_HOME=/home/dev/.gradle
PNPM_HOME=/home/dev/.local/share/pnpm
BUN_INSTALL=/home/dev/.bun
BETTERWRIGHT_CHROMIUM_PATH=/usr/bin/chromium
# A comma-separated CLI argument list: starts with `-`, and is a list.
BETTERWRIGHT_CHROMIUM_ARGS=--no-sandbox,--disable-dev-shm-usage
_oldIFS=$IFS
IFS=$' \t\n'
# 32 hex characters, and still not a secret: an account ID is an identifier, not a key.
# It sits just under the entropy threshold on purpose — this is the boundary case.
CLOUDFLARE_ACCOUNT_ID=7f3a9c2e5b1d8a4f6c0e2b9d5a1f8c3e
EDITOR=vim
VISUAL=vim

# --- genuine secrets: each proves a different signal is load-bearing ----------
# name signal (uses the same word list as the scrubber's key/value pass)
CLINE_API_KEY=a1B2c3D4e5F6g7H8i9J0k1L2M3n4P5q6R7s8T9u0V1w2X3y4Z5
CLOUDFLARE_API_TOKEN=xK9mQ2pL7vN4wR8tY3uJ6hB1nC5dF0gA2sD4fG7hK1mN3pQ
OPENCODE_API_KEY=oc_live_9f8e7d6c5b4a39281706f5e4d3c2b1a099887766554433
ZAI_CODING_CN_API_KEY=zai_sk_3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a
# name signal alone: short values are below every shape threshold, and a weak secret
# under `*secret*` is still a secret the user wants to see.
SENTRY_SECRET=abc123
# format signal alone: no sensitive word in the name, so only the provider prefix says so.
GH_PAT=ghp_FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE
# shape signal alone: no provider prefix, no sensitive word — just an opaque token.
LEGACY_KEY=mF7kQ2pL9vN4wR8tY3uJ6hB1nC5dF0gA2sD4fG7hK1mN3
# a DSN carrying userinfo is credential-bearing even under a neutral name
DATABASE_URL=postgres://admin:s3cr3tpass@db.internal:5432/app
